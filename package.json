{
  "name": "cryptian",
  "version": "0.1.0",
  "description": "MCrypt-compatible cipher suite for Node.js: reads and writes data from PHP mcrypt, including Rijndael 192/256-bit blocks and legacy ciphers OpenSSL dropped",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "lint": "eslint . --ext ts"
  },
  "keywords": [
    "3des",
    "aes",
    "blowfish",
    "cast",
    "cbc",
    "cfb",
    "cipher",
    "crypto",
    "ctr",
    "des",
    "encryption",
    "gost",
    "legacy",
    "libmcrypt",
    "mcrypt",
    "migration",
    "ofb",
    "padding",
    "php",
    "pkcs7",
    "rijndael",
    "serpent",
    "tripledes",
    "twofish"
  ],
  "author": "Tugrul Topuz <tugrultopuz@gmail.com>",
  "bugs": {
    "url": "https://github.com/tugrul/cryptian/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tugrul/cryptian.git"
  },
  "license": "MIT",
  "dependencies": {
    "bindings": "^1.5.0",
    "nan": "^2.28.0"
  },
  "devDependencies": {
    "@types/bindings": "^1.5.1",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.6",
    "@types/stream-buffers": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "eslint": "^8.36.0",
    "jest": "^29.5.0",
    "node-gyp": "^13.0.1",
    "stream-buffers": "^3.0.2",
    "ts-jest": "^29.0.5",
    "typescript": "^4.9.5"
  },
  "gypfile": true,
  "files": [
    "dist/",
    "addon/lib/",
    "addon/src/",
    "binding.gyp",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
